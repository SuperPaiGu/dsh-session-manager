{
  "name": "dsh-session-manager",
  "version": "0.2.6",
  "description": "DSH 批量管理会话（纯增量）：侧栏底部批量管理，每行可单删或多选批量删除（进系统回收站），删除后即时刷新",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
